rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own profile and day slips.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /days/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
